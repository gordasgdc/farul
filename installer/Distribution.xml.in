<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Farul</title>
    <license file="license.txt"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_localSystem="true"/>
    <choices-outline><line choice="default"><line choice="dev.gordas.Farul.pkg"/></line></choices-outline>
    <choice id="default"/>
    <choice id="dev.gordas.Farul.pkg" visible="false"><pkg-ref id="dev.gordas.Farul.pkg"/></choice>
    <pkg-ref id="dev.gordas.Farul.pkg" version="@VERSION@" onConclusion="none">Farul-component.pkg</pkg-ref>
</installer-gui-script>
