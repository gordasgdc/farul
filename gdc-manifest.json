{
  "$schema": "https://gdc.internal/schemas/plugin-manifest-v1.json",
  "name": "Farul",
  "publisher": "GDC",
  "version": "0.2.0",
  "description": "Monitor de sistem și rețea pentru macOS: procesor, memorie, trafic, discuri, baterie și procese active, în bara de meniu.",
  "category": "utility",
  "platforms": {
    "macos": {
      "executable": "Applications/Farul.app",
      "minOSVersion": "13.0",
      "signed": false,
      "notarized": false
    }
  },
  "icon": {
    "svg": "macOS/Farul/Resources/AppIcon.svg",
    "png256": "macOS/Farul/Resources/Assets.xcassets/AppIcon.appiconset/icon_256x256.png"
  },
  "localization": [
    "ro",
    "en",
    "es"
  ],
  "buildStage": "alpha",
  "release": {
    "channel": "alpha",
    "checkIntervalHours": 12,
    "updateManifestPath": "docs/update.json"
  }
}
